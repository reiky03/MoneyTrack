    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "ed1073f9-a66d-464b-a592-eb02d06208e1"
      }
    },
    "owner": "siddiq03"
